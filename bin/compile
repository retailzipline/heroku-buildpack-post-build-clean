#!/usr/bin/env bash

set -euo pipefail

readonly BUILD_DIR=$1
readonly CLEAN_FILES=.slug-post-clean

if [[ ! -n "${BUILD_DIR}" ]]; then
  echo "No build directory specified - exiting"
  exit 0
fi

cd ${BUILD_DIR}

if [[ ! -f "${CLEAN_FILES}" ]]; then
  echo "Could not find .slug-post-clean file - exiting"
  exit 0
fi

while read file; do
  [[ ! -n "${file}" ]] && continue

  if [[ -f "${file}" ]]; then
    echo "Removing file ${file} from slug"
    rm -f ${file}
  elif [[ -d "${file}" ]]; then
    echo "Removing directory ${file} from slug"
    rm -rf ${file}
  else
    echo "Location ${file} not found - ignoring"
  fi
done <${CLEAN_FILES}

# Strip test/spec/doc directories from installed gems — these are not needed at
# runtime and can add 25MB+ to the slug.
if [[ -d "vendor/bundle" ]]; then
  echo "Stripping test/spec/doc directories from vendor/bundle"
  find vendor/bundle -maxdepth 5 -type d \( -name test -o -name spec -o -name docs -o -name doc \) -exec rm -rf {} + 2>/dev/null || true
fi
